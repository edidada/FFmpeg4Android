# ffmpeg 3.2.5 (git submodule) built 100% from source with pure CMake
# (CMake + Ninja + the Android NDK toolchain, native on Windows: no configure,
# no make, no bash). Per-ABI source lists live in ffmpeg_sources.cmake
# (generated by scripts/gen_ffmpeg_src_list.ps1 from each library's own Makefile
# OBJS rules against the generated config.h); generated headers
# (config.h/avconfig.h/ffversion.h/bsf_list.c/protocol_list.c) live per-ABI in
# ffmpeg_generated/<abi>.
include(${CMAKE_SOURCE_DIR}/cmake/ffmpeg_sources.cmake)

set(FFMPEG_GEN ${FFMPEG_GENERATED}/${ANDROID_ABI})
if(NOT EXISTS "${FFMPEG_GEN}/config.h")
  message(FATAL_ERROR
    "config.h for ${ANDROID_ABI} not found in ${FFMPEG_GENERATED}.\n"
    "Regenerate with scripts/gen_ffmpeg_config.sh (one-time, per config change).")
endif()

# ABI -> source-list tag used by ffmpeg_sources.cmake
if(ANDROID_ABI STREQUAL "arm64-v8a")
  set(FFMPEG_ABI_TAG ARM64_V8A)
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
  set(FFMPEG_ABI_TAG ARMV7A)
elseif(ANDROID_ABI STREQUAL "x86")
  set(FFMPEG_ABI_TAG X86)
elseif(ANDROID_ABI STREQUAL "x86_64")
  set(FFMPEG_ABI_TAG X86_64)
else()
  message(FATAL_ERROR "Unsupported ANDROID_ABI: ${ANDROID_ABI}")
endif()

# Flags equivalent to what ffmpeg's configure would pass on linux/Android for a
# shared build. HAVE_AV_CONFIG_H routes all internal headers; PIC because
# everything is built as shared libs.
set(FFMPEG_FLAGS
  -DHAVE_AV_CONFIG_H
  -D_ISOC99_SOURCE
  -D_FILE_OFFSET_BITS=64
  -D_LARGEFILE_SOURCE
  -DPIC)

# avutil's core include set (config.h/avconfig.h/ffversion.h come from
# FFMPEG_GEN first, then the source tree); link system libs Android needs.
set(FFMPEG_COMMON_DEFS ${FFMPEG_FLAGS})
set(FFMPEG_INCS ${FFMPEG_GEN} ${FFMPEG_SRC})

add_library(avutil SHARED
  ${FFMPEG_AVUTIL_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(avutil PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(avutil PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libavutil)
target_link_libraries(avutil PRIVATE m dl)

add_library(avcodec SHARED
  ${FFMPEG_AVCODEC_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(avcodec PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(avcodec PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libavcodec)
# zlib include dir comes in via the `zlib` target INTERFACE; png* need zlib.h.
# opusdec.c uses swr_* (SWR context), hence the swresample link dependency.
target_link_libraries(avcodec PRIVATE avutil swresample zlib m dl)

add_library(avformat SHARED
  ${FFMPEG_AVFORMAT_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(avformat PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(avformat PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libavformat)
target_link_libraries(avformat PRIVATE avcodec avutil zlib m dl)

add_library(swresample SHARED
  ${FFMPEG_SWRESAMPLE_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(swresample PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(swresample PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libswresample)
target_link_libraries(swresample PRIVATE avutil m)

add_library(swscale SHARED
  ${FFMPEG_SWSCALE_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(swscale PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(swscale PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libswscale)
target_link_libraries(swscale PRIVATE avutil m)

add_library(avfilter SHARED
  ${FFMPEG_AVFILTER_SRCS_${FFMPEG_ABI_TAG}})
target_compile_definitions(avfilter PRIVATE ${FFMPEG_COMMON_DEFS})
target_include_directories(avfilter PRIVATE ${FFMPEG_INCS} ${FFMPEG_GEN}/libavfilter)
target_link_libraries(avfilter PRIVATE avformat avcodec swscale swresample avutil m dl)

# avcodec_register_all()/avformat_register_all()/etc. register components via
# `extern ff_x; if (CONFIG_X) ...` blocks - they rely on the optimizer folding
# the constant-zero branches away or the (disabled) ff_x symbols stay
# referenced at link time. Pin a minimum optimization level on those few
# translation units so Debug builds link too.
set(FFMPEG_REG_SOURCES
  ${FFMPEG_SRC}/libavcodec/allcodecs.c
  ${FFMPEG_SRC}/libavformat/allformats.c
  ${FFMPEG_SRC}/libavfilter/allfilters.c)
foreach(SRC ${FFMPEG_REG_SOURCES})
  set_property(SOURCE ${SRC} PROPERTY COMPILE_OPTIONS -O1)
endforeach()
